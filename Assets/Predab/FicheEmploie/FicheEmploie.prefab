  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\xC0 l\u2019aise avec les chiffres et attentif aux d\xE9tails, vous intervenez
    au centre des op\xE9rations financi\xE8res. Vous appliquez les r\xE8gles fiscales,
    comptables et sociales en vigueur afin de garantir la fiabilit\xE9 des comptes,
    la conformit\xE9 r\xE9glementaire et le bon fonctionnement de l\u2019entreprise.\nEn
    rejoignant notre \xE9quipe, vous jouerez un r\xF4le cl\xE9 dans la gestion financi\xE8re
    et contribuerez directement \xE0 la stabilit\xE9 et au d\xE9veloppement de notre
    organisation."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 37819d04c60c44344b7c34d1501d445d, type: 2}
